{
  "name": "cf-telegram-notify-gateway",
  "version": "0.1.0",
  "description": "A tiny, stateless notification relay from webhooks and services to Telegram, built for Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
